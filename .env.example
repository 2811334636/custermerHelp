APP_LLM_BASE_URL=https://api.deepseek.com/
APP_LLM_API_KEY=sk-your-key-here
APP_LLM_MODEL=deepseek-flash
APP_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
APP_LLM_MAX_OUTPUT_TOKENS=1024
APP_LLM_TEMPERATURE=0.3
APP_HISTORY_TOKEN_BUDGET=4096
# 中文 token 计数标定值，单位：字符/token。上游为中文时 1 字≈1.47 token，
# 取 1.5 使估算与实测比值 ≈1.02（spec §3.6②）。改小=更省预算但可能截断，
# 改大=更保守。此值直接决定历史剪裁的 token 预算是否可信。
APP_TOKEN_CHARS_PER_TOKEN=1.5
# 保留待用：历史落 MySQL 后这两项不再被任何代码读取（只有配置校验与单测引用）。
# 保留是因为会话上限的思路以后可能还要用，删了反而丢信息。
APP_SESSION_MAX_SESSIONS=200
APP_SESSION_MAX_MESSAGES=100
# 宿主 3306 被本机 MySQL80 服务 + VMware NAT 转发规则占用，容器映射到 3307，
# 故这里必须是 3307（docker-compose.yml 的 ports 与此处要同步改）。
APP_DB_URL=mysql+aiomysql://app:apppw@127.0.0.1:3307/customer_service?charset=utf8mb4
APP_DEFAULT_USER_ID=anonymous
APP_TOOL_TIMEOUT_S=3.0
APP_TOOL_MAX_RETRIES=2
APP_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
APP_EMBEDDING_API_KEY=sk-your-key-here
APP_EMBEDDING_MODEL=BAAI/bge-m3
APP_EMBEDDING_DIM=1024
APP_MILVUS_URI=http://127.0.0.1:19530
APP_MILVUS_COLLECTION=knowledge
APP_RETRIEVAL_TOP_K=3
APP_CHUNK_MAX_CHARS=400
APP_CHUNK_OVERLAP_CHARS=80
APP_EMBED_BATCH_SIZE=16
